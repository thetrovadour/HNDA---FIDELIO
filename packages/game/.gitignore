# Unity-generated folders — regenerated by the Editor, never commit
Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/
MemoryCaptures/

# Asset meta-data and generated files Unity does not own
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Autogenerated solution / project files (Unity recreates on demand)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D-generated meta files for non-existent assets
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D crash and log files
sysinfo.txt
crashlytics-build.properties

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app

# IDE
.vs/
.vscode/
.idea/
