# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fidelio_dev

# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000

# Internal bridge auth (shared secret for X-Bridge-Secret header)
BRIDGE_SECRET=change_me_in_production

# JWT (for admin/merchant routes)
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Bridge URL (backend calls the bridge for reconciliation retries)
BRIDGE_HTTP_URL=http://localhost:3002

# Redemption tiers (in CATR)
REDEMPTION_TIER_ADMIN_MIN=50
REDEMPTION_TIER_VAULT_MIN=500

# Reconciliation job
RECONCILIATION_STALE_MINUTES=30
RECONCILIATION_MAX_ATTEMPTS=3

# Base L2
BASE_RPC_URL=https://mainnet.base.org
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
